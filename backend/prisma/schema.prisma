generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING 
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id            Int               @id @default(autoincrement())
  fullName      String
  email         String            @unique
  password      String
  role          Role              @default(STAFF)
  createdAt     DateTime          @default(now())
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  approvals     ProjectApproval[]

  assignedProjects Project[] @relation("ProjectManagerRelation")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                  Int               @id @default(autoincrement())

  externalId          String            @unique // projectId from Sales portal
  source              String @default("SALES")

  status              String            // ACTIVE, etc

  projectName         String

  clientId            String?
  clientName          String

  productId           String?
  productName         String?
  productType         String?

  projectManagerId Int?
  projectManager User? @relation("ProjectManagerRelation", fields: [projectManagerId], references: [id])

  salesId             String?
  location            String?
  amcPercentage       Float?
  saleTypes           String?

  commencementDate    DateTime?
  purchaseOrderDate   DateTime?

  milestones          Json?
  resources           Json?

  pmoAddress          String?
  startDate           DateTime?
  endDate             DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  completedAt         DateTime?
  currentStageOrder   Int               @default(0)
  dueDate             DateTime?
  progressPercent     Float             @default(0)
  workflowStatus      WorkflowStatus    @default(UNASSIGNED)

  description         String?
  auditLogs           AuditLog[]
  escalations         Escalation[]
  stages              ProjectStage[]
  timelines           ProjectTimeline[]
  approvals           ProjectApproval[]
}

model ProjectStage {
  id              Int            @id @default(autoincrement())
  projectId       Int
  stageIndex      Int
  stageName       String
  stageOrder      Int
  stageKey        String?
  workflowStatus  WorkflowStatus @default(LOCKED)
  checklist       Json
  requiredDocs    Json?
  completed       Boolean        @default(false)
  completedAt     DateTime?
  submittedAt     DateTime?
  submittedBy     Int?
  approvedAt      DateTime?
  approvedBy      Int?
  escalated       Boolean        @default(false)
  escalatedAt     DateTime?
  escalatedBy     Int?
  rejectedAt      DateTime?
  rejectedBy      Int?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageOrder])
}

model ProjectApproval {
  id          Int            @id(map: "ProjectApproval_pkey") @default(autoincrement())
  projectId   Int
  stage       Int
  status      ApprovalStatus @default(PENDING)
  approvedBy  Int?
  comment     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rejectedBy  Int?
  submittedBy Int?
  approver    User?          @relation(fields: [approvedBy], references: [id], map: "ProjectApproval_approvedBy_fkey")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ProjectApproval_projectId_fkey")

  @@index([projectId, stage], map: "ProjectApproval_projectId_stage_idx")
  @@map("project_approvals")
}

model ProjectTimeline {
  id        Int      @id @default(autoincrement())
  projectId Int
  stage     Int
  action    String
  note      String?
  createdBy Int?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Escalation {
  id         Int             @id @default(autoincrement())
  projectId  Int
  stage      Int
  level      EscalationLevel @default(LOW)
  reason     String
  resolved   Boolean         @default(false)
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, resolved])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  projectId Int?
  module    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([projectId])
}

enum Role {
  HEADOFOPS
  PROJECTMANAGER
  STAFF
}

enum WorkflowStatus {
  UNASSIGNED
  LOCKED
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

enum EscalationLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
