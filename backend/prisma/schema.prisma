generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum Role {
  HEADOFOPS
  PROJECTMANAGER
  STAFF
}

enum WorkflowStatus {
  UNASSIGNED
  LOCKED
  OPEN
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

enum EscalationLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ResourceStatus {
  ASSIGNED
  ACTIVE
  ON_HOLD
  RELEASED
}

enum ReportType {
  PROJECT
  STAGE
  PROGRESS
  WEEKLY
  MONTHLY
  RESOURCE
  RISK
  STATUS
  CLOSURE
  CUSTOM
}

enum ReportFormat {
  PDF
  EXCEL
}

enum ReminderType {
  GENERAL
  TASK_DUE
  PROJECT_DUE
  STAGE_DUE
  APPROVAL
  REVIEW
  MEETING
  FOLLOW_UP
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  approvals     ProjectApproval[]

  assignedProjects Project[] @relation("ProjectManagerRelation")
  assignedTasks    Task[]    @relation("TaskAssignee")
  createdTasks     Task[]    @relation("TaskAssigner")
  ownedTasks       Task[]    @relation("TaskCreator")

  createdReports Report[] @relation("ReportCreator")

  reminders Reminder[]

  timelineEntries ProjectTimeline[] @relation("TimelineCreatedBy")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id Int @id @default(autoincrement())

  projectId String @unique // projectId from Sales portal
  source    String @default("SALES")

  status String // ACTIVE, etc

  projectName String

  clientId   String?
  clientName String

  productId   String?
  productName String?
  productType String?

  projectManagerId Int?
  projectManager   User? @relation("ProjectManagerRelation", fields: [projectManagerId], references: [id])

  salesId       String?
  location      String?
  amcPercentage Float?
  saleTypes     String?

  commencementDate  DateTime?
  purchaseOrderDate DateTime?

  milestones Json?
  resources  Json?

  pmoAddress String?
  startDate  DateTime?
  endDate    DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  currentStageOrder Int            @default(0)
  dueDate           DateTime?
  progressPercent   Float          @default(0)
  workflowStatus    WorkflowStatus @default(UNASSIGNED)

  description String?

  auditLogs   AuditLog[]
  escalations Escalation[]
  stages      ProjectStage[]
  timelines   ProjectTimeline[]
  approvals   ProjectApproval[]

  tasks     Task[]
  reports   Report[]
  reminders Reminder[]

  @@index([projectManagerId])
  @@index([status])
  @@index([workflowStatus])
  @@index([dueDate])
  @@index([startDate])
  @@index([endDate])
}

model ProjectStage {
  id        Int    @id @default(autoincrement())
  projectId String

  stageIndex Int
  stageName  String
  stageOrder Int
  stageKey   String?

  workflowStatus WorkflowStatus @default(LOCKED)
  checklist      Json
  requiredDocs   Json?

  completed   Boolean   @default(false)
  completedAt DateTime?

  submittedAt DateTime?
  submittedBy Int?

  approvedAt DateTime?
  approvedBy Int?

  escalated   Boolean   @default(false)
  escalatedAt DateTime?
  escalatedBy Int?

  rejectedAt      DateTime?
  rejectedBy      Int?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  tasks     Task[]
  reports   Report[]
  reminders Reminder[]

  @@unique([projectId, stageOrder])
  @@index([projectId])
  @@index([workflowStatus])
}

model ProjectApproval {
  id          Int            @id(map: "ProjectApproval_pkey") @default(autoincrement())
  projectId   String
  stage       Int
  status      ApprovalStatus @default(PENDING)
  approvedBy  Int?
  comment     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rejectedBy  Int?
  submittedBy Int?

  approver User? @relation(fields: [approvedBy], references: [id], map: "ProjectApproval_approvedBy_fkey")

  project Project @relation(
    fields: [projectId],
    references: [projectId],
    onDelete: Cascade,
    map: "ProjectApproval_projectId_fkey"
  )

  @@index([projectId, stage], map: "ProjectApproval_projectId_stage_idx")
  @@index([approvedBy])
  @@map("project_approvals")
}

model ProjectTimeline {
  id        Int      @id @default(autoincrement())
  projectId String
  stage     Int
  action    String
  note      String?
  createdBy Int?
  createdAt DateTime @default(now())

  project Project @relation(
    fields: [projectId],
    references: [projectId],
    onDelete: Cascade
  )

  createdByUser User? @relation(
    "TimelineCreatedBy",
    fields: [createdBy],
    references: [id],
    onDelete: SetNull
  )

  @@index([projectId])
  @@index([createdBy])
  @@index([createdAt])
}

model Escalation {
  id         Int             @id @default(autoincrement())
  projectId  String
  stage      Int
  level      EscalationLevel @default(LOW)
  reason     String
  resolved   Boolean         @default(false)
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  project Project @relation(
    fields: [projectId],
    references: [projectId],
    onDelete: Cascade
  )

  @@index([projectId, resolved])
  @@index([level])
  @@index([createdAt])
}

model Task {
  id Int @id @default(autoincrement())

  projectId Int
  stageId   Int?

  assignedById Int
  createdById  Int

  assignedToUserId Int?

  assignedResourceId String?

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  stage ProjectStage? @relation(
    fields: [stageId],
    references: [id],
    onDelete: SetNull
  )

  assignedToUser User? @relation(
    "TaskAssignee",
    fields: [assignedToUserId],
    references: [id]
  )

  assignedBy User @relation(
    "TaskAssigner",
    fields: [assignedById],
    references: [id]
  )

  createdBy User @relation(
    "TaskCreator",
    fields: [createdById],
    references: [id]
  )

  reminders Reminder[]

  @@index([projectId])
  @@index([stageId])
  @@index([assignedToUserId])
}

model Report {
  id          Int    @id @default(autoincrement())
  projectId   String
  stageId     Int?
  createdById Int?

  title       String
  description String?

  // Defines the type of analytics report generated
  type ReportType @default(PROJECT)

  // Defines the exported report format
  format ReportFormat

  // Snapshot of the project analytics at the time
  // the report was generated.
  // This preserves historical report data even when
  // the project changes later.
  content Json?

  // Generated file information
  fileUrl  String?
  fileName String?
  fileType String?

  // Optional reporting period
  periodStart DateTime?
  periodEnd   DateTime?

  // Report generation timestamp
  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(
    fields: [projectId],
    references: [projectId],
    onDelete: Cascade
  )

  stage ProjectStage? @relation(
    fields: [stageId],
    references: [id],
    onDelete: SetNull
  )

  createdBy User? @relation(
    "ReportCreator",
    fields: [createdById],
    references: [id],
    onDelete: SetNull
  )

  @@index([projectId])
  @@index([stageId])
  @@index([createdById])
  @@index([type])
  @@index([format])
  @@index([generatedAt])
  @@index([projectId, type, generatedAt])
}

model Reminder {
  id        Int  @id @default(autoincrement())
  userId    Int
  projectId String?
  taskId    Int?
  stageId   Int?

  title   String
  message String?

  type   ReminderType   @default(GENERAL)
  status ReminderStatus @default(PENDING)

  remindAt DateTime

  sentAt      DateTime?
  dismissedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  project Project? @relation(
    fields: [projectId],
    references: [projectId],
    onDelete: Cascade
  )

  task Task? @relation(
    fields: [taskId],
    references: [id],
    onDelete: Cascade
  )

  stage ProjectStage? @relation(
    fields: [stageId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([stageId])
  @@index([remindAt])
  @@index([status])
  @@index([type])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  projectId String?
  module    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  project Project? @relation(
    fields: [projectId],
    references: [projectId]
  )

  user User? @relation(
    fields: [userId],
    references: [id]
  )

  @@index([projectId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}
