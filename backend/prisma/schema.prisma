generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int               @id @default(autoincrement())
  fullName      String
  email         String            @unique
  password      String
  role          Role              @default(STAFF)
  createdAt     DateTime          @default(now())
  auditLogs     AuditLog[]
  projects      Project[]         @relation("PMOProjects")
  refreshTokens RefreshToken[]
  approvals     ProjectApproval[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                  Int               @id @default(autoincrement())
  projectName         String
  clientName          String
  industry            String?
  productName         String?
  projectManager      String?
  salesId             String?
  pmoId               Int?
  status              String            @default("stage1")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  completedAt         DateTime?
  currentStage        Int               @default(1)
  dueDate             DateTime?
  progressPercent     Float             @default(0)
  startDate           DateTime?
  workflowStatus      WorkflowStatus    @default(OPEN)
  projectManagerEmail String?
  description         String?
  auditLogs           AuditLog[]
  escalations         Escalation[]
  pmo                 User?             @relation("PMOProjects", fields: [pmoId], references: [id])
  stages              ProjectStage[]
  timelines           ProjectTimeline[]
  approvals           ProjectApproval[]
}

model ProjectStage {
  id              Int            @id @default(autoincrement())
  projectId       Int
  stageIndex      Int
  stageName       String
  workflowStatus  WorkflowStatus @default(LOCKED)
  checklist       Json
  requiredDocs    Json?
  completed       Boolean        @default(false)
  completedAt     DateTime?
  submittedAt     DateTime?
  submittedBy     Int?
  approvedAt      DateTime?
  approvedBy      Int?
  escalated       Boolean        @default(false)
  escalatedAt     DateTime?
  escalatedBy     Int?
  rejectedAt      DateTime?
  rejectedBy      Int?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageIndex])
}

model ProjectApproval {
  id          Int            @id(map: "ProjectApproval_pkey") @default(autoincrement())
  projectId   Int
  stage       Int
  status      ApprovalStatus @default(PENDING)
  approvedBy  Int?
  comment     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  stageModel  String
  rejectedBy  Int?
  submittedBy Int?
  approver    User?          @relation(fields: [approvedBy], references: [id], map: "ProjectApproval_approvedBy_fkey")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ProjectApproval_projectId_fkey")

  @@index([projectId, stage], map: "ProjectApproval_projectId_stage_idx")
  @@map("project_approvals")
}

model ProjectTimeline {
  id        Int      @id @default(autoincrement())
  projectId Int
  stage     Int
  action    String
  note      String?
  createdBy Int?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Escalation {
  id         Int             @id @default(autoincrement())
  projectId  Int
  stage      Int
  level      EscalationLevel @default(LOW)
  reason     String
  resolved   Boolean         @default(false)
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, resolved])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  projectId Int?
  module    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([projectId])
}

enum Role {
  HEADOFOPS
  PROJECTMANAGER
  STAFF
}

enum WorkflowStatus {
  LOCKED
  OPEN
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EscalationLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
