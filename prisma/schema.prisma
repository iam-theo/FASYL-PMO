generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("staff")
  createdAt DateTime @default(now())
}

model Project {
  id            Int     @id @default(autoincrement())
  projectName   String
  client        String
  type          String
  location      String
  siteCode      String
  AMC           String
  projectManager String
  product       String
  status        String
  registerFor   String[]
  purchaseDate  DateTime
  expectedDate  DateTime
  createdAt     DateTime @default(now())
}